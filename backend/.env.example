# Copy this file to .env and adjust if needed. These defaults match the
# `postgres` service in the root docker-compose.yml, so `docker compose up -d`
# + `cp .env.example .env` is enough to get a working local database.

DATABASE_URL="postgresql://quiz_builder:quiz_builder@localhost:5433/quiz_builder?schema=public"

# Port the Express API listens on.
PORT=4000
